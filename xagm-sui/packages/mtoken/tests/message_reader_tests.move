#[test_only]
module mtoken::message_reader_tests;

use mtoken::message_reader;
use std::unit_test::assert_eq;

#[test]
fun read_u256() {
    // prettier-ignore
    let bytes = vector[
        0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef,
        0x02, 0x34, 0x56, 0x78, 0x9a, 0xbc, 0xde, 0xf0,
        0x03, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef, 0x12,
        0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc, 0xde, 0xf0,
    ];

    let mut reader = message_reader::new(bytes);
    assert_eq!(
        reader.read_u256(),
        0x0123456789abcdef023456789abcdef003456789abcdef12123456789abcdef0,
    );
}
